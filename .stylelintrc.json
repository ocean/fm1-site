{
  "extends": "stylelint-config-standard",
  "ignoreFiles": ["node_modules/**", "dist/**", ".artifacts/**"],
  "rules": {
    "selector-class-pattern": [
      "^[a-z][a-z0-9]*(-[a-z0-9]+)*(--[a-z0-9]+(-[a-z0-9]+)*)?$",
      { "message": "Use kebab-case class names, with an optional --modifier" }
    ],
    "no-descending-specificity": null,
    "value-keyword-case": ["lower", { "ignoreProperties": ["/^--(font|mono)$/", "font-family", "font"] }]
  }
}
