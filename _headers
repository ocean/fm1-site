/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# ESTAMPIE's site: its emulator streams WebAssembly, its installer reads firmware packages, and its
# licence files should show in the browser. (No Permissions-Policy anywhere: the installer and
# editor need Web MIDI with SysEx.)
/estampie/*.wasm
  Content-Type: application/wasm

/estampie/*.fwsc
  Content-Type: application/octet-stream

/estampie/*.md
  Content-Type: text/plain; charset=utf-8

/estampie/firmware/LICENSE
  Content-Type: text/plain; charset=utf-8

# FM-SWITCH's firmware list: public data the app (and anyone) can fetch, refreshed daily.
/firmwares.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *

# ESTAMPIE's words files, which other sites fetch: the FM-1 Screen Reader
# (charlesvestal.github.io) loads the one the FM-1 links to. Public, fetched without credentials,
# and named by a fingerprint of their content, so they never change.
/estampie/words/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable
